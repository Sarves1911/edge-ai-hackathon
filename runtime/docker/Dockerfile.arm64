# linux/arm64 build environment matching the UNO Q's Debian userland.
#
#   runtime/scripts/build_arm64.sh   builds this image and runs configure/build/ctest in it.

FROM --platform=linux/arm64 debian:trixie

ARG ORT_VERSION=1.31.0

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        curl \
        libavcodec-dev \
        libavformat-dev \
        libavutil-dev \
        libswscale-dev \
        pkg-config \
        v4l-utils \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL \
        "https://github.com/microsoft/onnxruntime/releases/download/v${ORT_VERSION}/onnxruntime-linux-aarch64-${ORT_VERSION}.tgz" \
        | tar -xz -C /opt \
    && ln -s "/opt/onnxruntime-linux-aarch64-${ORT_VERSION}" /opt/onnxruntime

ENV ONNXRUNTIME_ROOT=/opt/onnxruntime
ENV LD_LIBRARY_PATH=/opt/onnxruntime/lib

WORKDIR /src
